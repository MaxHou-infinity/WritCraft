# WritCraft V0 · 开发者环境变量参考
# 应用不会自动读取仓库或写作项目中的 .env。
# 日常使用请在应用设置中保存 Key；自动化启动时可显式 export 以下变量。

# 主推 Key（支持全 5 模态）
WRITCRAFT_MINIMAX_KEY=«redacted:sk-api-…  或  sk-cp-…（Token Plan / Coding Plan）»

# 备选 Key（可同主推 Key；Token Plan Key 支持 M2.7/M3/image/speech 全模态）
WRITCRAFT_MINIMAX_CP_KEY=«redacted:sk-api-…  或  sk-cp-…»

# 调试模式
WRITCRAFT_DEBUG=true
WRITCRAFT_LOG_LEVEL=info
